<?xml version="1.0" encoding="UTF-8"?>
<!--
    Log4j2 配置文件（优化版）
    支持全链路追踪，自动打印 traceId
-->
<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <!-- 日志输出格式（带颜色 - Log4j2 语法） -->
        <property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight{[%5p]} %cyan{[traceId:%X{traceId}]} [%t] %blue{%-40.40c{1.}} : %m%n</property>
        <!-- 文件日志格式（无颜色） -->
        <property name="FILE_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%5p] [traceId:%X{traceId}] [parentService:%X{parentService}] [currentService:%X{currentService}] [%t] %-40.40c{1.} : %m%n</property>
        <!-- 日志文件路径 -->
        <property name="LOG_PATH">../logs</property>
    </Properties>

    <Appenders>
        <!-- 控制台输出 -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <!-- 所有日志 -->
        <RollingFile name="RollingFileAll"
                     fileName="${LOG_PATH}/app.log"
                     filePattern="${LOG_PATH}/%d{yyyy-MM}/app-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- INFO 级别日志 -->
        <RollingFile name="RollingFileInfo"
                     fileName="${LOG_PATH}/info.log"
                     filePattern="${LOG_PATH}/%d{yyyy-MM}/info-%d{yyyy-MM-dd}-%i.log.gz">
            <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- WARN 级别日志 -->
        <RollingFile name="RollingFileWarn"
                     fileName="${LOG_PATH}/warn.log"
                     filePattern="${LOG_PATH}/%d{yyyy-MM}/warn-%d{yyyy-MM-dd}-%i.log.gz">
            <ThresholdFilter level="WARN" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- ERROR 级别日志 -->
        <RollingFile name="RollingFileError"
                     fileName="${LOG_PATH}/error.log"
                     filePattern="${LOG_PATH}/%d{yyyy-MM}/error-%d{yyyy-MM-dd}-%i.log.gz">
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- SQL日志 (p6spy) -->
        <RollingFile name="RollingFileSql"
                     fileName="${LOG_PATH}/sql.log"
                     filePattern="${LOG_PATH}/%d{yyyy-MM}/sql-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Spring Boot 相关日志级别 -->
        <Logger name="org.springframework" level="INFO"/>
        <Logger name="org.springframework.web" level="INFO"/>
        <Logger name="org.springframework.boot" level="INFO"/>

        <!-- Tomcat 相关日志级别 -->
        <Logger name="org.apache.catalina" level="WARN"/>
        <Logger name="org.apache.tomcat" level="WARN"/>
        <Logger name="org.apache.coyote" level="WARN"/>

        <!-- MyBatis 相关日志级别 -->
        <Logger name="org.apache.ibatis" level="INFO"/>
        <Logger name="com.baomidou.mybatisplus" level="INFO"/>

        <!-- 链路追踪日志 (INFO 级别) -->
        <Logger name="cn.myslayers.common.trace" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFileAll"/>
        </Logger>

        <!-- Service 层日志 (INFO 级别) -->
        <Logger name="cn.myslayers.libra.framework.toolkit.demo.service" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFileAll"/>
        </Logger>

        <!-- Mapper 层日志 (DEBUG 级别，可在生产环境改为 INFO) -->
        <Logger name="cn.myslayers.libra.framework.toolkit.demo.mapper" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFileAll"/>
        </Logger>

        <!-- p6spy SQL日志 -->
        <Logger name="p6spy" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFileSql"/>
        </Logger>

        <!-- Druid SQL日志 -->
        <Logger name="druid.sql" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFileSql"/>
        </Logger>

        <!-- Root Logger -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFileAll"/>
            <AppenderRef ref="RollingFileInfo"/>
            <AppenderRef ref="RollingFileWarn"/>
            <AppenderRef ref="RollingFileError"/>
        </Root>
    </Loggers>

</Configuration>
